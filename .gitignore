# Python virtual environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets: never commit a real .env (only .env.example is tracked)
.env

# Raw CI logs downloaded by collect/fetch_failed_logs.py: never commit these
data/raw/*
!data/raw/.gitkeep

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
